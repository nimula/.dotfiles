#!/usr/bin/env zsh
# Author : nimula+github@gmail.com
#
set -Eeuo pipefail

source print_utils.sh


function usage() {
  setopt local_options posix_argzero

  cat <<EOF
Git worktree management with organized directory structure.

$(tput bold)USAGE$(tput sgr0)
  $(tput bold; tput setaf 74)$(basename "$0") <command> [augments] [options]$(tput sgr0)

$(tput bold)COMMAND$(tput sgr0)
  switch, sw <branch>           Switch to a branch in new worktree
  create <branch> [base]        Create new branch in worktree (default: main/master)
  list, ls                      List all worktrees
  remove, rm [-f] <ref|pattern> Remove by branch, detached HEAD SHA, or pattern
  prune                         Remove worktree administrative files
  shellenv                      Output shell function for auto-cd (source this)

$(tput bold)OPTIONS$(tput sgr0)
  -f, --force         For remove: drop a worktree with uncommitted
                      changes, and skip confirmation for patterns or
                      shared SHAs. Repeat it (-f -f) to remove
                      a locked worktree, as git itself requires.
  -s, --silent        Silent mode (do not prompt for input)
  -h, --help          Show this help message

Setup auto-cd:
  Add to ~/.bashrc or ~/.zshrc:
    source <(git-wt shellenv)

Worktrees are organized at: $PWD$/<repo>/<branch>
EOF
}

  # wt = worktree
  # wa = worktree add
  # wl = worktree list
  # wo = worktree lock
  # wm = worktree move
  # wp = worktree prune
  # wr = worktree remove
  # wu = worktree unlock

function main() {
  local command
  if [ $# -eq 0 ]; then
    command="list"
  else
    command="$1"
    shift
  fi


  case "$command" in
    init)
      init $@
      ;;
    checkout|co|switch|sw)
      switch $@
      ;;
    create)
      create $@
      ;;
    list|ls)
      list $@
      ;;
    remove|rm)
      remove $@
      ;;
    prune)
      prune $@
      ;;
    shellenv)
      shellenv $@
      ;;
    help|--help|-h)
        usage
        ;;
    *)
      print_error "Unknown command: $command"
      usage
      exit 1
      ;;
  esac
}

